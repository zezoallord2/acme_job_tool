# ---------------------------------------------------------------------------
# Acme Jobs — zero-cost local configuration (copy to .env)
#
# Everything below works with NO paid service. See docs/ZERO_COST_MODE.md
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=Acme Jobs
APP_URL=http://localhost:3100

# --- Database (local PostgreSQL, free) --------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/acme_jobs?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/acme_jobs_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/acme_jobs?schema=public"

# --- Zero-cost preset -------------------------------------------------------
# ON  = manual AI + local AI allowed, Acme-paid AI disabled, local filesystem,
#       PostgreSQL queue, internal analytics, internal observability.
ZERO_COST_MODE=true
APP_VERSION=1.0.0
SCHEMA_VERSION=1

# --- Auth (self-hosted, free) ----------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-change-me-0000000000000000000000000000"
SESSION_TTL_HOURS=336
PASSWORD_MIN_LENGTH=10
# DEV ONLY. Never set in production.
DEV_LOG_MAGIC_LINKS=true

# --- Local data directory ---------------------------------------------------
DATA_DIR=./data
STORAGE_PROVIDER=local

# --- Background jobs (PostgreSQL-backed queue, free) ------------------------
QUEUE_PROVIDER=postgres
QUEUE_POLL_INTERVAL_MS=2000
QUEUE_BATCH_SIZE=5
QUEUE_MAX_ATTEMPTS=3
QUEUE_LOCK_TIMEOUT_MS=120000
RUN_WORKER_INLINE=true

# --- Observability (local structured logs + DB records) ---------------------
LOG_LEVEL=info
LOG_DIR=./data/logs
OBSERVABILITY_PROVIDER=internal

# --- Analytics (internal PostgreSQL, free) ---------------------------------
ANALYTICS_PROVIDER=internal
PRODUCT_LEARNING_ENABLED=true

# --- AI (Manual Mode is the default and is always available) ----------------
# Priority order when ZERO_COST_MODE=true: local AI (if reachable) -> manual.
AI_MODE_PRIORITY=local,gemini,openrouter,openai,anthropic,manual
DEFAULT_AI_PROVIDER=local

# Optional local AI (Ollama or any llama.cpp-compatible HTTP endpoint).
# Nothing here is required for Acme Jobs to work.
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=acme-jobs
LOCAL_AI_TIMEOUT_MS=60000
LOCAL_AI_MAX_CONTEXT=4096
# Keep false unless you intentionally operate a trusted, TLS-protected AI host.
# Ollama's normal local address is permitted without this override.
LOCAL_AI_ALLOW_REMOTE=false
# Required when LOCAL_AI_ALLOW_REMOTE=true and the endpoint is not loopback.
LOCAL_AI_API_KEY=
LOCAL_AI_MAX_RESPONSE_BYTES=1000000

# Bring-your-own-key (optional). Leave blank unless you supply your own key.
# Acme Jobs never pays for these; usage is billed to your provider account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Acme-funded AI is intentionally unavailable in the zero-cost release.
ACME_AI_ENABLED=false

# --- Entitlements / billing -------------------------------------------------
# ManualAdminEntitlementProvider is always available and needs no credentials.
ENTITLEMENT_PROVIDER=manual
BILLING_PROVIDER=manual
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_ID=

# --- Email (optional) -------------------------------------------------------
# In-app notifications always work with no email provider at all.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_ENABLED=false

# --- Storage (local filesystem by default) ----------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Rate limiting (database/in-memory, free) --------------------------------
RATE_LIMIT_PROVIDER=database

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880

# --- Encryption for user-supplied API keys ----------------------------------
KEY_ENCRYPTION_SECRET="dev-only-change-me-0000000000000000000000000000"

# --- Auto-repair guard ------------------------------------------------------
# Automated repair execution is refused unless the environment is local.
ALLOW_AUTO_REPAIR_IN_ENV=local_dev
