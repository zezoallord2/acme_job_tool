# ---------------------------------------------------------------------------
# Acme Jobs — zero-cost local configuration (copy to .env)
#
# Everything below works with NO paid service. See docs/ZERO_COST_MODE.md
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=Acme Jobs
APP_URL=http://localhost:3100

# --- Database (local PostgreSQL, free) --------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/acme_jobs?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/acme_jobs_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/acme_jobs?schema=public"

# --- Zero-cost preset -------------------------------------------------------
# ON  = manual AI + local AI allowed, Acme-paid AI disabled, local filesystem,
#       PostgreSQL queue, internal analytics, internal observability.
ZERO_COST_MODE=true
APP_VERSION=1.0.0
SCHEMA_VERSION=1

# --- Auth (self-hosted, free) ----------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-change-me-0000000000000000000000000000"
SESSION_TTL_HOURS=336
PASSWORD_MIN_LENGTH=10
# DEV ONLY. Never set in production.
DEV_LOG_MAGIC_LINKS=true

# --- Local data directory ---------------------------------------------------
DATA_DIR=./data
STORAGE_PROVIDER=local

# --- Background jobs (PostgreSQL-backed queue, free) ------------------------
QUEUE_PROVIDER=postgres
QUEUE_POLL_INTERVAL_MS=2000
QUEUE_BATCH_SIZE=5
QUEUE_MAX_ATTEMPTS=3
QUEUE_LOCK_TIMEOUT_MS=120000
RUN_WORKER_INLINE=true

# --- Observability (local structured logs + DB records) ---------------------
LOG_LEVEL=info
LOG_DIR=./data/logs
OBSERVABILITY_PROVIDER=internal

# --- Analytics (internal PostgreSQL, free) ---------------------------------
ANALYTICS_PROVIDER=internal
PRODUCT_LEARNING_ENABLED=true

# --- AI: on by default for every plan, on the SERVER's keys ------------------
# Chain: Gemini (free) -> OpenRouter free model -> the user's own key (Settings).
# Without any key, AI features say "AI unavailable" and offer Manual Mode.
# Never commit real keys: keep them in your local .env only.
ACME_AI_ENABLED=true
AI_MODE_PRIORITY=gemini,openrouter
DEFAULT_AI_PROVIDER=gemini

# Free key, about 2 minutes, no card: https://aistudio.google.com/apikey
# Free-tier limits are small (roughly 5-15 RPM, ~20 requests/day on Flash).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# https://openrouter.ai/keys - free models: 20/min, 50/day (1,000/day after
# buying 10 credits once). `openrouter/free` routes to an available free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional extra server providers (billed to whoever owns the key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Per-user daily caps (abuse control instead of paywalls).
TAILOR_DAILY_CAP_FREE=5
TAILOR_DAILY_CAP_PAID=30
INTERVIEW_DAILY_CAP_FREE=3
INTERVIEW_DAILY_CAP_PAID=20
JOB_REFRESH_DAILY_CAP_FREE=10
JOB_REFRESH_DAILY_CAP_PAID=40

# --- Job search sources --------------------------------------------------------
# Keyless and always on: Arbeitnow, RemoteOK, Remotive, Himalayas, Jobicy,
# We Work Remotely, HN Who is hiring, The Muse, Greenhouse/Lever/Ashby boards.
# Every keyed source below is a no-op (shown as "key missing") until set.
# Optional comma-separated allow-list of provider ids; empty = all.
JOB_SEARCH_PROVIDERS=
JOB_PROVIDER_TIMEOUT_MS=9000

# Adzuna - https://developer.adzuna.com/signup (250/day, 2,500/month).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=us,gb

# Jooble - https://jooble.org/api/about (500 requests per key, lifetime).
JOOBLE_API_KEY=
JOOBLE_MONTHLY_GLOBAL=40

# USAJobs (US federal only) - https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
# The email address you registered with (sent as the User-Agent).
USAJOBS_USER_AGENT=

# The Muse - optional key raises limits: https://www.themuse.com/developers/api/v2
THEMUSE_API_KEY=

# Google Jobs via SerpAPI - https://serpapi.com/users/sign_up
# 250 free searches/month; each page is one search. Indexes LinkedIn, Indeed,
# Glassdoor and company sites, so their listings appear here (labelled "via ...").
SERPAPI_API_KEY=
SERPAPI_PAGES=2
SERPAPI_MONTHLY_GLOBAL=240
SERPAPI_MONTHLY_PER_USER=10

# JSearch - https://app.openwebninja.com/api/jsearch (official host, ~100/month)
# or the legacy RapidAPI host via RAPIDAPI_KEY.
JSEARCH_API_KEY=
RAPIDAPI_KEY=
JSEARCH_PAGES=2
JSEARCH_MONTHLY_GLOBAL=90
JSEARCH_MONTHLY_PER_USER=10

# --- Entitlements / billing -------------------------------------------------
# ManualAdminEntitlementProvider is always available and needs no credentials.
ENTITLEMENT_PROVIDER=manual
BILLING_PROVIDER=manual
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_ID=

# --- Email (optional) -------------------------------------------------------
# In-app notifications always work with no email provider at all.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_ENABLED=false

# --- Storage (local filesystem by default) ----------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Rate limiting (database/in-memory, free) --------------------------------
RATE_LIMIT_PROVIDER=database

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880

# --- Encryption for user-supplied API keys ----------------------------------
KEY_ENCRYPTION_SECRET="dev-only-change-me-0000000000000000000000000000"

# --- Auto-repair guard ------------------------------------------------------
# Automated repair execution is refused unless the environment is local.
ALLOW_AUTO_REPAIR_IN_ENV=local_dev
