{
  "name": "acme-jobs",
  "version": "1.0.0",
  "private": true,
  "description": "Acme Jobs - Better Opportunities Ahead. AI-assisted job search operating system built on evidence.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:eval": "vitest run tests/eval",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:desktop": "playwright test --project=desktop",
    "e2e:mobile": "playwright test --project=mobile",
    "e2e:ui": "playwright test --project=desktop --ui",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:full": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e",
    "integrity:check": "tsx scripts/integrity-check.ts",
    "production:check": "tsx scripts/production-check.ts",
    "worker:build": "esbuild src/worker/index.ts --bundle --platform=node --target=node20 --external:@prisma/client --external:pg --outfile=dist/worker/index.js",
    "build:cli": "esbuild scripts/production-check.ts --bundle --platform=node --target=node20 --external:@prisma/client --external:pg --outfile=dist/scripts/production-check.js && esbuild scripts/integrity-check.ts --bundle --platform=node --target=node20 --external:@prisma/client --external:pg --outfile=dist/scripts/integrity-check.js",
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx src/worker/index.ts",
    "ai:local:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-ollama.ps1",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "backup:verify": "bash scripts/verify-backup.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "next": "^15.5.27",
    "nodemailer": "^10.0.15",
    "pino": "^9.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.15.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@opennextjs/cloudflare": "^1.20.9",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.4",
    "deepmerge-ts": "^8.0.2",
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "braces": "^3.0.3",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true
  }
}
