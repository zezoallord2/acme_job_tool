// Acme Jobs â€” canonical data model
// Three canonical objects: Career, Job, Application.
// Everything else (evidence, claims, artifacts, learning, operations) derives from them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

