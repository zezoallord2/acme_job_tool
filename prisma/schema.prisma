// ---------------------------------------------------------------------------
// Identity, tenancy, entitlements
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified DateTime?
  // Null for OAuth-only accounts. Never selected by application code.
  passwordHash  String?
  name          String?
  isAdmin       Boolean  @default(false)
  isInternal    Boolean  @default(false)
  suspendedAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  settings      UserSettings?
  profile       UserProfile?
  entitlements  Entitlement[]
  onboardings   OnboardingProgress[]

  careerProfile CareerMasterProfile?
  employments   EmploymentRecord[]
  educations    EducationRecord[]
  certifications Certification[]
  skills        Skill[]
  projects      Project[]
  volunteers    VolunteerExperience[]
  languages     LanguageRecord[]
  awards        AwardRecord[]
  narrative     CareerNarrative[]
  voiceProfiles VoiceProfile[]
  evidence      Evidence[]
  evidenceConflicts EvidenceConflict[]
  achievements  Achievement[]
  targetRoles   TargetRole[]
  careerFacts   CareerFactRecord[]
  generatedClaims GeneratedClaim[]
  evidenceMatches EvidenceMatch[]

  jobs          JobPosting[]
  jobAnalyses   JobAnalysis[]
  evidenceMatrices EvidenceMatrix[]
  applications  Application[]
  resumes       Resume[]
  coverLetters  CoverLetter[]
  appAnswers    ApplicationAnswer[]
  starStories   StarStory[]
  interviews    Interview[]
  interviewSessions InterviewSession[]
  followUps     FollowUp[]
  sprints       Sprint[]
  aiInteractions AIInteraction[]

  statusEvents ApplicationStatusEvent[]
  applicationArtifacts ApplicationArtifact[]
  applicationSnapshots ApplicationSnapshot[]
  applicationNotes ApplicationNote[]
  readinessChecks ReadinessCheck[]
  learningEvents LearningEvent[]
  distilledPatterns DistilledPattern[]
  evidenceProposals EvidenceProposal[]
  applicationOutcomes ApplicationOutcome[]
  preferenceSignals UserPreferenceSignal[]
  systemErrors   SystemError[]
  traceRecords   TraceRecord[]
  versionedArtifacts VersionedArtifact[]
  interviewAnswers InterviewAnswer[]
  resumeBullets  ResumeBullet[]
  feedback       AIInteractionFeedback[]
  notifications  Notification[]
  bugReports     BugReport[]
  integrations   UserIntegration[]
  auditLogs      AuditLog[]
  requests       RateLimitBucket[]
  dataExports   DataExportRequest[]
  apiKeys       UserApiKey[]
  idempotencyKeys IdempotencyKey[]
  workItems      WorkQueueItem[]
  sessions       Session[]

  @@index([deletedAt])
  @@index([isAdmin])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  ipHash       String?
  userAgent    String?
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  theme             ThemePreference   @default(SYSTEM)
  locale            String            @default("en")
  timezone          String            @default("UTC")
  aiProvider        AIProviderName    @default(MANUAL)
  aiModel           String?
  analyticsEnabled  Boolean           @default(false)
  productLearningEnabled Boolean      @default(true)

  notifyInterviews  Boolean @default(true)
  notifyFollowUps   Boolean @default(true)
  notifyDeadlines   Boolean @default(true)
  notifyDrafts      Boolean @default(false)
  notifyReminders   Boolean @default(true)

  reduceMotion      Boolean @default(false)
  autosaveEnabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique

  firstName       String?
  lastName        String?
  phone           String?
  email           String?
  locationCity    String?
  locationCountry String?
  linkedinUrl     String?
  portfolioUrl    String?
  websiteUrl      String?
  headline        String?
  summary         String?
  workArrangement WorkArrangement @default(NO_PREFERENCE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OnboardingProgress {
  id     String @id @default(cuid())
  userId String

  step               OnboardingStep @default(FIRST_NAME)
  firstName          String?
  experienceLevel    ExperienceLevel?
  currentSituation   String?
  targetRole         String?
  targetIndustry     String?
  isCareerChanger    Boolean?
  locationPreference String?
  workArrangement    WorkArrangement?
  primaryGoal        UserGoal?
  snapshotCreatedAt  DateTime?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Entitlement {
  id       String          @id @default(cuid())
  userId   String
  plan     EntitlementPlan
  status   EntitlementStatus @default(ACTIVE)

  source        BillingProviderName @default(MANUAL_ADMIN)
  externalEventId String?
  externalCustomerId String?
  externalSubscriptionId String?

  startsAt   DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotent grant: the same external event can only ever grant once.
  @@unique([source, externalEventId])
  @@index([userId, status])
}

model UserIntegration {
  id     String @id @default(cuid())
  userId String

  provider      BillingProviderName
  externalUserId String
  externalEmail  String?
  rawSummary    Json?
  lastSyncedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalUserId])
  @@index([userId])
}

model UserApiKey {
  id     String @id @default(cuid())
  userId String

  provider   AIProviderName
  label      String?
  // Never returned by any API. Stored encrypted.
  encryptedKey Bytes
  keyHint    String
  keyStatus  KeyStatus           @default(ACTIVE)
  lastUsedAt DateTime?
  lastErrorAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, keyStatus])
}

enum KeyStatus {
  ACTIVE
  DISABLED
  ERRORING
}

model AuditLog {
  id      String @id @default(cuid())
  userId  String?
  action  String
  entity  String
  entityId String?
  outcome String
  traceId String?
  metadata Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([traceId])
}

model RateLimitBucket {
  id     String @id @default(cuid())
  userId String?
  key    String
  windowStart DateTime
  count  Int      @default(0)
  limitValue Int

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, windowStart])
  @@index([windowStart])
}

// ---------------------------------------------------------------------------
// CAREER â€” what is factually true about the user
// ---------------------------------------------------------------------------

model CareerMasterProfile {
  id     String @id @default(cuid())
  userId String @unique

  targetRolePrimary   String?
  targetRoleSecondary String?
  targetIndustry      String?
  yearsExperience     Float?
  isCareerChanger     Boolean  @default(false)
  careerChangeFrom    String?
  careerChangeTo      String?
  currentSituation    String?
  primaryGoal         UserGoal?

  headline        String?
  professionalSummary String?
  openToWork       Boolean @default(true)
  availableFrom    DateTime?

  completenessPercent Int    @default(0)
  version          Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmploymentRecord {
  id     String @id @default(cuid())
  userId String

  companyName     String
  jobTitle        String
  employmentType  String?
  location        String?
  startDate       DateTime?
  endDate         DateTime?
  isCurrent       Boolean  @default(false)
  description     String?
  highlights      String[]
  verification    VerificationStatus @default(USER_CONFIRMED)
  sortOrder       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence  Evidence[]

  @@index([userId, startDate])
}

model EducationRecord {
  id     String @id @default(cuid())
  userId String

  institution   String
  degree        String?
  fieldOfStudy  String?
  startDate     DateTime?
  endDate       DateTime?
  grade         String?
  description   String?
  verification VerificationStatus @default(USER_CONFIRMED)
  sortOrder     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence  Evidence[]

  @@index([userId])
}

model Certification {
  id     String @id @default(cuid())
  userId String

  name          String
  issuer        String?
  issuedDate    DateTime?
  expiresAt     DateTime?
  credentialId  String?
  url           String?
  isMandatoryForAnyRole Boolean @default(false)
  verification  VerificationStatus @default(USER_CONFIRMED)
  sortOrder     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence  Evidence[]

  @@index([userId])
}

model Skill {
  id     String @id @default(cuid())
  userId String

  name           String
  category       String?
  proficiencyLevel Int?
  yearsUsed      Float?
  isCore         Boolean @default(false)
  verification   VerificationStatus @default(USER_CONFIRMED)
  sortOrder      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence  Evidence[]

  @@unique([userId, name])
  @@index([userId])
}

model Project {
  id     String @id @default(cuid())
  userId String

  name        String
  description String?
  role        String?
  techStack   String[]
  startDate   DateTime?
  endDate     DateTime?
  url         String?
  outcomes    String?
  verification VerificationStatus @default(USER_CONFIRMED)
  sortOrder   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence  Evidence[]
  achievements Achievement[]

  @@index([userId])
}

model VolunteerExperience {
  id     String @id @default(cuid())
  userId String

  organization String
  role         String?
  startDate    DateTime?
  endDate      DateTime?
  description  String?
  verification VerificationStatus @default(USER_CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
